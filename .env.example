# --- Database -------------------------------------------------------------
# Local dev (Postgres from `docker compose up db`):
DATABASE_URL="postgresql://salon:salon@localhost:5432/salon?schema=public"

# Used by docker-compose.yml for the db container
POSTGRES_USER=salon
POSTGRES_PASSWORD=salon
POSTGRES_DB=salon

# --- Seed (initial admin passwords; change after first login) -------------
SEED_OWNER_PASSWORD=changeme123
SEED_STAFF_PASSWORD=changeme123

# --- Auth (staff login) ----------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string

# --- Public URL (used in e-mail links) ------------------------------------
APP_URL=http://localhost:3000

# --- E-mail (SMTP) ----------------------------------------------------------
# Leave SMTP_HOST empty in development: e-mails are then printed to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Salon de Choix <booking@salondechoix.dk>"
MAIL_REPLY_TO=hello@salondechoix.dk

# --- Reminders ----------------------------------------------------------------
# Shared secret for the hourly reminder job (cron container → /api/cron/reminders)
CRON_SECRET=replace-me-with-another-long-random-string
# Local hour from which day-before reminders are sent
REMINDER_HOUR=10
